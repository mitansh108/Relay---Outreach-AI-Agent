# Local demo: no Supabase account is needed.
COPILOT_AUTH_MODE=demo
COPILOT_MODE=demo
# Default demo DB is backend/copilot_workspace.db; old copilot.db is preserved.
# For Supabase use the restricted relay_app role, SSL, and the private schema.
# COPILOT_DATABASE_URL=postgresql+psycopg://relay_app:URL_ENCODED_PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
COPILOT_ENCRYPTION_KEY=
COPILOT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COPILOT_PUBLIC_API_URL=http://localhost:8000
COPILOT_PUBLIC_WEB_URL=http://localhost:3000
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional local-demo credentials only. Supabase workspaces use saved keys/address.
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.3-70b-versatile
GOOGLE_SENDER_EMAIL=
